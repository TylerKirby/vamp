#!/bin/bash

# vamp: Terminal-native Claude Code development environment
# Like a jazz vamp - keeps the rhythm while you improvise with Claude
#
# Usage: vamp [project-dir]
#        vamp status
#        vamp kill [session-name]
#        vamp list

# Disable errexit for _watcher subcommand (must survive transient errors)
if [[ "${1:-}" != "_watcher" ]]; then
    set -e
fi

VAMP_VERSION="2.0.0"

# Configuration - customize via ~/.config/vamp/config or env vars
CLAUDE_CMD="${VAMP_CLAUDE_CMD:-claude}"
CLAUDE_FLAGS="${VAMP_CLAUDE_FLAGS:---dangerously-skip-permissions}"
PROJECTS_DIR="${VAMP_PROJECTS_DIR:-$HOME/Projects}"

# Verbose/debug mode - set via flags or env vars
VAMP_VERBOSE="${VAMP_VERBOSE:-}"
VAMP_DEBUG="${VAMP_DEBUG:-}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

# ============================================
# Logging helpers
# ============================================

# Log verbose messages (shown with --verbose or VAMP_VERBOSE=1)
# Output goes to stderr to not pollute normal output
log_verbose() {
    [[ -n "$VAMP_VERBOSE" ]] && echo -e "${DIM}$*${NC}" >&2
    return 0
}

# Log debug messages (shown with --debug or VAMP_DEBUG=1)
# Includes [DEBUG] prefix and timestamp for troubleshooting
log_debug() {
    [[ -n "$VAMP_DEBUG" ]] && echo -e "${DIM}[DEBUG $(date +%H:%M:%S)] $*${NC}" >&2
    return 0
}

# Log a command before executing it (for --debug mode)
# Usage: run_cmd "description" command args...
run_cmd() {
    local desc="$1"
    shift
    log_debug "$desc: $*"
    "$@"
}

# ============================================
# Progress indicators
# ============================================

# Check if we're outputting to a TTY (interactive terminal)
# Progress indicators are hidden when piped or redirected
is_tty() {
    [ -t 1 ]
}

# Show progress for discrete steps: (1/4), (2/4), etc.
# Usage: show_progress current total "message"
# Example: show_progress 2 4 "Creating worktree"
show_progress() {
    local current="$1"
    local total="$2"
    local message="$3"

    is_tty || return 0
    printf "\r  ${DIM}(%d/%d)${NC} %s" "$current" "$total" "$message"
}

# Clear the current progress line
clear_progress() {
    is_tty || return 0
    printf "\r\033[K"
}

# Spinner characters for indeterminate progress
SPINNER_CHARS='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
SPINNER_PID=""

# Start a background spinner with a message
# Usage: start_spinner "message"
start_spinner() {
    local message="$1"
    is_tty || return 0

    # Don't start if already running
    [ -n "$SPINNER_PID" ] && return 0

    (
        local i=0
        local len=${#SPINNER_CHARS}
        while true; do
            printf "\r  ${CYAN}${SPINNER_CHARS:$i:1}${NC} %s" "$message"
            i=$(( (i + 1) % len ))
            sleep 0.1
        done
    ) &
    SPINNER_PID=$!
    disown $SPINNER_PID 2>/dev/null
}

# Stop the spinner and clear the line
stop_spinner() {
    is_tty || return 0

    if [ -n "$SPINNER_PID" ]; then
        kill $SPINNER_PID 2>/dev/null
        wait $SPINNER_PID 2>/dev/null
        SPINNER_PID=""
        clear_progress
    fi
}

# Ensure spinner is stopped on script exit
trap 'stop_spinner' EXIT

# ============================================
# Error handling helpers
# ============================================

# Show an error message with optional remediation suggestion
# Usage: show_error "message" ["suggestion"]
show_error() {
    local message="$1"
    local suggestion="${2:-}"

    echo -e "${RED}Error: $message${NC}" >&2
    if [ -n "$suggestion" ]; then
        echo -e "${DIM}  → $suggestion${NC}" >&2
    fi
}

# Show an error and exit
# Usage: die "message" ["suggestion"] [exit_code]
die() {
    local message="$1"
    local suggestion="${2:-}"
    local exit_code="${3:-1}"

    show_error "$message" "$suggestion"
    exit "$exit_code"
}

# Capture git command output and show detailed error on failure
# Usage: git_cmd "description" git args...
# Returns git exit code, stores stderr in GIT_ERROR
GIT_ERROR=""
git_cmd() {
    local desc="$1"
    shift
    local stderr_file=$(mktemp)

    log_debug "$desc: git $*"

    if git "$@" 2>"$stderr_file"; then
        rm -f "$stderr_file"
        return 0
    else
        local exit_code=$?
        GIT_ERROR=$(cat "$stderr_file")
        rm -f "$stderr_file"
        log_debug "git failed (exit $exit_code): $GIT_ERROR"
        return $exit_code
    fi
}

# Check if a git error is retryable (transient network issue)
# Usage: is_retryable_git_error "$error_message"
# Returns 0 if retryable, 1 if permanent
is_retryable_git_error() {
    local error="$1"

    # Retryable network errors
    local retryable_patterns=(
        "Could not resolve host"
        "Connection refused"
        "Connection timed out"
        "Network is unreachable"
        "Connection reset by peer"
        "Failed to connect"
        "Unable to access"
        "Couldn't resolve host"
        "The requested URL returned error: 5"  # 5xx server errors
        "SSL_connect"
        "gnutls_handshake"
        "Operation timed out"
    )

    for pattern in "${retryable_patterns[@]}"; do
        if [[ "$error" == *"$pattern"* ]]; then
            return 0  # Retryable
        fi
    done

    return 1  # Not retryable (permanent error)
}

# Push with automatic retry on transient network failures
# Usage: git_push_with_retry [git push args...]
# Returns 0 on success, 1 on permanent failure after all retries
# Respects VAMP_PUSH_RETRIES env var (default: 3)
git_push_with_retry() {
    local max_retries="${VAMP_PUSH_RETRIES:-3}"
    local attempt=1
    local backoff=1
    local stderr_file=$(mktemp)
    local all_errors=""

    log_debug "git_push_with_retry: max_retries=$max_retries, args: $*"

    while [ "$attempt" -le "$max_retries" ]; do
        log_debug "Push attempt $attempt/$max_retries"

        if git push "$@" 2>"$stderr_file"; then
            rm -f "$stderr_file"
            if [ "$attempt" -gt 1 ]; then
                echo -e "${GREEN}Push succeeded on attempt $attempt${NC}"
            fi
            return 0
        fi

        local exit_code=$?
        local error=$(cat "$stderr_file")
        GIT_ERROR="$error"

        # Accumulate errors for final report
        all_errors="${all_errors}Attempt $attempt: $error"$'\n'

        log_debug "Push failed (exit $exit_code): $error"

        # Check if error is retryable
        if ! is_retryable_git_error "$error"; then
            rm -f "$stderr_file"
            log_verbose "Push failed with permanent error (not retrying)"
            show_error "Git push failed" "This appears to be a permanent error, not a network issue"
            echo -e "${DIM}Error: $error${NC}" >&2
            return 1
        fi

        # If we have more retries, wait and try again
        if [ "$attempt" -lt "$max_retries" ]; then
            echo -e "${YELLOW}Push failed (network error), retrying ($((attempt + 1))/$max_retries)...${NC}"
            log_verbose "Waiting ${backoff}s before retry"
            sleep "$backoff"
            # Exponential backoff: 1s, 2s, 4s
            backoff=$((backoff * 2))
        fi

        ((attempt++))
    done

    rm -f "$stderr_file"

    # All retries exhausted
    show_error "Git push failed after $max_retries attempts" "Check your network connection and try again"
    echo -e "${DIM}Errors from all attempts:${NC}" >&2
    echo -e "${DIM}$all_errors${NC}" >&2
    return 1
}

# Load config if exists
[ -f "$HOME/.config/vamp/config" ] && source "$HOME/.config/vamp/config"

# Default patterns for files to ignore when checking dirty state
# These are common dev artifacts that shouldn't block merge operations
# Override via VAMP_IGNORE_DIRTY env var (pipe-separated patterns)
VAMP_IGNORE_DIRTY_DEFAULT="__pycache__|\.pyc$|\.swarm-prompt|\.vamp-worker|\.gitignore|\.db$|\.beads/|\.coverage|\.log$|\.pytest_cache|node_modules|\.DS_Store|\.env\.local"
VAMP_IGNORE_DIRTY="${VAMP_IGNORE_DIRTY:-$VAMP_IGNORE_DIRTY_DEFAULT}"

# Filter out ignorable files from git status output
# Usage: echo "$git_status" | filter_ignorable_dirty
filter_ignorable_dirty() {
    local pattern="$VAMP_IGNORE_DIRTY"
    # Convert pipe-separated patterns to grep -v chain
    # Filter both untracked (??) and modified (M/A/D) files matching patterns
    grep -vE "($pattern)" 2>/dev/null || true
}

# ============================================
# Subcommands
# ============================================

show_help() {
    echo -e "${CYAN}"
    cat << 'LOGO'
  ♪♫                            ♫♪
   __   __  __ _  _ __ ___   _ __
   \ \ / / / _` || '_ ` _ \ | '_ \
    \ V / | (_| || | | | | || |_) |
     \_/   \__,_||_| |_| |_|| .__/
                            |_|
LOGO
    echo -e "${NC}"
    cat << EOF
  ${DIM}v${VAMP_VERSION} - Terminal-native Claude Code environment${NC}

${YELLOW}USAGE:${NC}
    vamp [project-dir]     Start dev environment (default: current dir)
    vamp list              List active vamp sessions
    vamp attach <name>     Attach to existing session
    vamp kill <name>       Kill a session
    vamp killall           Kill all vamp sessions
    vamp init              Initialize project with beads + CLAUDE.md
    vamp setup             Install beads hooks for Claude Code + git
    vamp sidebar            Restart the sidebar in current session
    vamp doctor            Validate setup and show recommendations
    vamp update            Update vamp to latest GitHub release
    vamp help              Show this help

${YELLOW}MULTI-AGENT MODE:${NC}
    vamp agent add <type>  Add agent (claude, codex, cursor)
    vamp agent list        List all agents and status
    vamp agent kill <id>   Kill an agent
    vamp agent merge       Merge agent branches to main

${YELLOW}EXAMPLES:${NC}
    vamp                   Start in current directory
    vamp ~/Projects/app    Start in specific directory
    vamp attach app        Attach to 'vamp-app' session
    vamp agent add claude  Add a Claude agent
    vamp list              Show all running sessions

${YELLOW}SIDEBAR TABS:${NC}
    1:players              Agent list and controls
    2:charts               File changes across agents
    3:beads                Issue tracker
    4:setlist              Activity log
    5:files                Project file tree with git status
    6:metrics              System, Claude usage, and agent health

${YELLOW}KEYBINDINGS:${NC}
    Ctrl-b + arrows        Navigate panes
    Ctrl-b + z             Zoom pane (toggle fullscreen)
    Ctrl-b + d             Detach (session keeps running)
    Tab / Shift-Tab        Cycle sidebar tabs
    1-6                    Direct tab select (in sidebar)

${YELLOW}MOUSE:${NC}
    Scroll wheel           Scroll pane content
    Click pane             Select pane
    Drag border            Resize pane

${YELLOW}GLOBAL FLAGS:${NC}
    --verbose              Show additional status messages
    --debug                Show all commands being executed (implies --verbose)

${YELLOW}CONFIG:${NC}
    ~/.config/vamp/config
    VAMP_VERBOSE=1         Enable verbose mode via environment
    VAMP_DEBUG=1           Enable debug mode via environment

EOF
}

list_sessions() {
    echo -e "${CYAN}Active vamp sessions:${NC}"
    local sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep "^vamp-" || true)
    if [ -z "$sessions" ]; then
        echo -e "${DIM}  No active sessions${NC}"
    else
        echo "$sessions" | while read -r session; do
            local project="${session#vamp-}"
            local windows=$(tmux list-windows -t "$session" -F '#{window_name}' 2>/dev/null | tr '\n' ' ')
            echo -e "  ${GREEN}●${NC} $project ${DIM}[$windows]${NC}"
        done
    fi
}

attach_session() {
    local name="$1"
    if [ -z "$name" ]; then
        echo -e "${RED}Usage: vamp attach <session-name>${NC}"
        list_sessions
        return 1
    fi
    
    local session="vamp-$name"
    if tmux has-session -t "$session" 2>/dev/null; then
        tmux attach-session -t "$session"
    else
        echo -e "${RED}Session '$session' not found${NC}"
        list_sessions
        return 1
    fi
}

kill_session() {
    local name="$1"
    if [ -z "$name" ]; then
        echo -e "${RED}Usage: vamp kill <session-name>${NC}"
        list_sessions
        return 1
    fi
    
    local session="vamp-$name"
    if tmux kill-session -t "$session" 2>/dev/null; then
        echo -e "${GREEN}Killed session: $session${NC}"
    else
        echo -e "${RED}Session '$session' not found${NC}"
    fi
}

kill_all_sessions() {
    local sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep "^vamp-" || true)
    if [ -z "$sessions" ]; then
        echo -e "${DIM}No vamp sessions to kill${NC}"
        return 0
    fi
    
    echo -e "${YELLOW}This will kill:${NC}"
    echo "$sessions" | sed 's/^/  /'
    read -p "Continue? [y/N] " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        echo "$sessions" | xargs -I {} tmux kill-session -t {}
        echo -e "${GREEN}All vamp sessions killed${NC}"
    fi
}

init_project() {
    local name=$(basename "$(pwd)")
    echo -e "${CYAN}Initializing project: $name${NC}"
    echo ""

    # ============================================
    # Check global setup first
    # ============================================
    local setup_needed=false
    local hooks_dir="$HOME/.claude/hooks"
    local global_claude_md="$HOME/.claude/CLAUDE.md"

    # Check Claude Code hooks
    if [ ! -d "$hooks_dir" ] || [ -z "$(ls -A "$hooks_dir" 2>/dev/null)" ]; then
        echo -e "  ${YELLOW}⚠${NC} Claude Code hooks not installed"
        setup_needed=true
    fi

    # Check global CLAUDE.md
    if [ ! -f "$global_claude_md" ]; then
        echo -e "  ${YELLOW}⚠${NC} Global CLAUDE.md not found"
        setup_needed=true
    elif ! grep -q "Beads Workflow" "$global_claude_md" 2>/dev/null; then
        echo -e "  ${YELLOW}⚠${NC} Global CLAUDE.md missing beads workflow"
        setup_needed=true
    fi

    # Offer to run vamp setup if needed
    if [ "$setup_needed" = true ]; then
        echo ""
        echo -e "  Global setup incomplete. Run ${CYAN}vamp setup${NC} for full integration."
        read -p "  Run vamp setup now? [Y/n] " setup_confirm
        if [[ ! "$setup_confirm" =~ ^[Nn]$ ]]; then
            echo ""
            setup_beads
            echo ""
            echo -e "${CYAN}Continuing with project initialization...${NC}"
        fi
        echo ""
    fi

    # ============================================
    # Project initialization
    # ============================================

    # Git
    if [ ! -d ".git" ]; then
        git init
        echo -e "  ${GREEN}✓${NC} Initialized git"
    fi
    
    # Beads
    if command -v bd &> /dev/null; then
        if [ ! -d ".beads" ] && [ ! -f ".beads.jsonl" ]; then
            bd init
            echo -e "  ${GREEN}✓${NC} Initialized beads"

            # CRITICAL: Configure dedicated sync branch to prevent conflicts with code commits
            # Without this, bd sync commits to main and can revert your code changes!
            bd config set sync.branch beads-sync 2>/dev/null
            echo -e "  ${GREEN}✓${NC} Configured beads sync branch (beads-sync)"
        else
            echo -e "  ${DIM}○${NC} Beads already initialized"

            # Check if sync branch is configured, warn if not
            local sync_branch=$(bd config get sync.branch 2>/dev/null | grep -v "not set" || true)
            if [ -z "$sync_branch" ]; then
                echo -e "  ${YELLOW}⚠${NC} Beads sync branch not set!"
                echo -e "      Run: bd config set sync.branch beads-sync"
                echo -e "      This prevents bd sync from reverting your code commits."
            fi
        fi

        # Install git hooks
        bd hooks install 2>/dev/null && echo -e "  ${GREEN}✓${NC} Git hooks installed"
    else
        echo -e "  ${YELLOW}○${NC} Beads not installed (brew tap steveyegge/beads && brew install beads)"
    fi
    
    # CLAUDE.md
    if [ ! -f "CLAUDE.md" ]; then
        cat > CLAUDE.md << EOF
# $name

## Project Overview
<!-- Brief description -->

## Tech Stack
<!-- Languages, frameworks, dependencies -->

## Development
- Task tracking: \`bd ready\` for available work
- Tests: \`<test command>\`

## Architecture
<!-- Key patterns and decisions -->

## Current Focus
<!-- Active work items -->
EOF
        echo -e "  ${GREEN}✓${NC} Created CLAUDE.md"
    else
        echo -e "  ${DIM}○${NC} CLAUDE.md exists"
    fi
    
    # AGENTS.md
    if [ ! -f "AGENTS.md" ]; then
        read -p "Create AGENTS.md for multi-agent coordination? [Y/n] " agents_confirm
        if [[ ! "$agents_confirm" =~ ^[Nn]$ ]]; then
            cat > AGENTS.md << 'AGENTS_EOF'
# Multi-Agent Coordination

This project uses [vamp](https://github.com/TylerKirby/vamp) for multi-agent development with git worktree isolation.

## Worktree Architecture

Each agent gets its own isolated directory and branch:

```
project/
├── .vamp-agents/
│   ├── claude-1/    → branch: agent/claude-1
│   ├── codex-1/     → branch: agent/codex-1
│   └── cursor-1/    → branch: agent/cursor-1
├── .vamp/           → state + IPC files
└── (main project)   → main branch
```

- The main agent works directly in the project directory (no worktree)
- Additional agents each get a git worktree in `.vamp-agents/<name>/`
- Each worktree has its own branch: `agent/<name>`
- Changes are isolated until explicitly merged

## Beads Sync Branch

**CRITICAL**: If using beads for issue tracking, ensure the sync branch is configured:
```bash
bd config set sync.branch beads-sync
```

⚠️ **Never sync beads to main** — this can revert your code changes. Always use a dedicated sync branch.

## Agent Workflow

**Adding agents:**
```bash
vamp agent add claude       # Add a Claude agent
vamp agent add codex        # Add a Codex agent
vamp agent add cursor       # Add a Cursor agent
```
Or press `[A]` in the sidebar Players tab.

**Monitoring:**
- Use the sidebar tabs (players/charts/beads/setlist)
- `vamp agent list` from the shell

**Renaming agents:**
Press `[R]` in the sidebar Players tab to rename the selected agent.

**Merging work:**
```bash
vamp agent merge            # Interactive merge of agent branches
vamp agent merge --all      # Auto-merge all agent branches
```
Or press `[m]` in the sidebar Charts tab.

## Naming Conventions

- Agents are auto-named by type: `claude-1`, `codex-1`, etc.
- Rename via sidebar `[R]` key for clarity (e.g., `auth-feature`, `api-refactor`)
- Agent IDs (used internally) remain unchanged after rename

## Merge Strategy

- Each agent branch is merged independently into the main branch
- If a merge conflicts, it is aborted and flagged in the sidebar Charts tab
- Resolve conflicts manually, then re-merge
- Use `vamp agent kill <id> --remove` to clean up finished agents (deletes worktree + branch)
AGENTS_EOF
            echo -e "  ${GREEN}✓${NC} Created AGENTS.md"
        fi
    else
        echo -e "  ${DIM}○${NC} AGENTS.md exists"
    fi

    # Append multi-agent section to CLAUDE.md if Claude Code is available
    if [ -f "CLAUDE.md" ] && command -v claude &>/dev/null; then
        if ! grep -q "Multi-Agent" CLAUDE.md 2>/dev/null; then
            cat >> CLAUDE.md << 'MULTI_AGENT_EOF'

## Multi-Agent Mode

This project supports multi-agent development via vamp. See [AGENTS.md](AGENTS.md) for:
- Worktree architecture and isolation model
- Agent workflow (add, monitor, rename, merge)
- Beads sync branch configuration (CRITICAL)
- Merge strategy and conflict resolution
MULTI_AGENT_EOF
            echo -e "  ${GREEN}✓${NC} Added multi-agent section to CLAUDE.md"
        fi
    fi

    # .gitignore
    if ! grep -q ".beads-cache" .gitignore 2>/dev/null; then
        echo -e "\n# Beads cache\n.beads-cache/" >> .gitignore
        echo -e "  ${GREEN}✓${NC} Updated .gitignore"
    fi
    
    echo -e "\n${GREEN}Ready! Run 'vamp' to start${NC}"
}

setup_beads() {
    local claude_md_only=""
    local permissions_only=""
    local deps_only=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --claude-md)
                claude_md_only="yes"
                shift
                ;;
            --permissions)
                permissions_only="yes"
                shift
                ;;
            --deps)
                deps_only="yes"
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    # If --claude-md flag, only setup CLAUDE.md
    if [ "$claude_md_only" = "yes" ]; then
        setup_claude_md
        return 0
    fi

    # If --permissions flag, only setup permissions
    if [ "$permissions_only" = "yes" ]; then
        setup_permissions
        return 0
    fi

    # If --deps flag, only install dependencies
    if [ "$deps_only" = "yes" ]; then
        install_dependencies
        return 0
    fi

    echo -e "${CYAN}Setting up beads integration...${NC}"
    echo ""

    if ! command -v bd &> /dev/null; then
        echo -e "  ${RED}✗${NC} beads not installed"
        echo -e "    Install: brew tap steveyegge/beads && brew install beads"
        return 1
    fi

    # Install Claude Code hooks
    echo -e "${BLUE}Installing Claude Code hooks...${NC}"
    bd setup claude
    echo -e "  ${GREEN}✓${NC} Claude Code hooks installed"

    # Install git hooks if in a git repo
    if [ -d ".git" ]; then
        echo -e "${BLUE}Installing git hooks...${NC}"
        bd hooks install 2>/dev/null && echo -e "  ${GREEN}✓${NC} Git hooks installed"
    else
        echo -e "  ${DIM}○${NC} Not a git repo, skipping git hooks"
    fi

    echo ""

    # Setup global CLAUDE.md
    setup_claude_md

    echo ""

    # Setup recommended permissions
    setup_permissions

    echo ""
    echo -e "${GREEN}Beads integration complete!${NC}"
    echo -e "  Restart Claude Code for hooks to take effect."
    echo -e "  Run 'vamp doctor' to verify setup."
}

# Install or update global CLAUDE.md with beads workflow
setup_claude_md() {
    local global_claude_md="$HOME/.claude/CLAUDE.md"
    local claude_dir="$HOME/.claude"

    echo -e "${CYAN}Setting up global CLAUDE.md...${NC}"

    # Ensure ~/.claude directory exists
    mkdir -p "$claude_dir"

    if [ -f "$global_claude_md" ]; then
        # File exists - check if beads section is present
        if grep -q "Beads Workflow" "$global_claude_md" 2>/dev/null; then
            echo -e "  ${GREEN}✓${NC} Global CLAUDE.md already has beads workflow"
            return 0
        else
            # Ask to append
            echo -e "  ${YELLOW}○${NC} Global CLAUDE.md exists but missing beads workflow"
            read -p "  Append beads workflow section? [Y/n] " append_confirm
            if [[ ! "$append_confirm" =~ ^[Nn]$ ]]; then
                echo "" >> "$global_claude_md"
                write_beads_section >> "$global_claude_md"
                echo -e "  ${GREEN}✓${NC} Appended beads workflow to CLAUDE.md"
            else
                echo -e "  ${DIM}○${NC} Skipped"
            fi
        fi
    else
        # Create new file with header and beads section
        cat > "$global_claude_md" << 'HEADER'
# Global Claude Code Instructions

These instructions apply to all projects.

HEADER
        write_beads_section >> "$global_claude_md"
        echo -e "  ${GREEN}✓${NC} Created $global_claude_md with beads workflow"
    fi
}

# Write beads workflow template to stdout (used by setup_claude_md)
write_beads_section() {
    cat << 'BEADS_EOF'
## Beads Workflow (Issue Tracking)

When working in a project with a `.beads/` directory, follow these practices for issue tracking and task management.

### Creating a Beads Project

To initialize beads in a new project:
```bash
bd init                    # Initialize beads in current directory
```

**CRITICAL: Configure a dedicated sync branch immediately after init:**
```bash
bd config set sync.branch beads-sync
```

⚠️ **Without this, `bd sync` commits to your main branch and CAN REVERT YOUR CODE CHANGES!** This has caused lost work multiple times. Always verify sync branch is set:
```bash
bd config get sync.branch  # Should NOT say "not set"
```

This creates a `.beads/` directory with the issue database. The `.beads/` directory is gitignored - beads syncs via a separate branch (`beads-sync`).

### Core Workflow

**Starting a session:**
```bash
bd ready                   # Show issues with no blockers
bd list --status=open      # All open issues
bd show <id>               # Detailed view with dependencies
```

**Working on issues:**
```bash
bd update <id> --status=in_progress  # Claim work
bd close <id>                         # Mark complete
bd close <id1> <id2> ...              # Close multiple at once
```

**Creating issues:**
```bash
bd create --title="..." --type=task|bug|feature --priority=2
# Priority: 0-4 (0=critical, 4=backlog). NOT "high"/"medium"/"low"
```

**Dependencies:**
```bash
bd dep add <issue> <depends-on>  # issue depends on depends-on
bd blocked                        # Show blocked issues
```

### Session Close Protocol

Before ending a session, ALWAYS run:
```bash
git status              # Check changes
git add <files>         # Stage code changes
bd sync                 # Sync beads
git commit -m "..."     # Commit code
bd sync                 # Sync any new beads changes
git push                # Push to remote
```

### When to Use Beads vs TodoWrite

- **Use Beads** for: Multi-session work, issues with dependencies, discovered work that needs tracking, bugs, features
- **Use TodoWrite** for: Simple single-session task execution, step-by-step progress within a session

When in doubt, prefer beads - persistence you don't need beats lost context.

## Recommended Permissions

Add to `.claude/settings.local.json` for smoother workflows:

```json
{
  "permissions": {
    "allow": [
      "Bash(bd:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
```

These are safe across all projects:
- `bd:*` - Beads issue tracking commands
- `git add/commit/status/diff/log` - Standard git operations (reversible, scoped to repo)
BEADS_EOF
}

# Setup recommended Claude Code permissions
setup_permissions() {
    local settings_file="$HOME/.claude/settings.local.json"
    local claude_dir="$HOME/.claude"

    echo -e "${CYAN}Setting up Claude Code permissions...${NC}"

    # Ensure ~/.claude directory exists
    mkdir -p "$claude_dir"

    # Define recommended permissions
    local recommended_permissions=(
        "Bash(bd:*)"
        "Bash(git add:*)"
        "Bash(git commit:*)"
        "Bash(git status:*)"
        "Bash(git diff:*)"
        "Bash(git log:*)"
        "Bash(docker:*)"
        "Bash(docker-compose:*)"
    )

    if [ -f "$settings_file" ]; then
        # File exists - check what's there and merge
        if ! command -v jq &>/dev/null; then
            echo -e "  ${YELLOW}○${NC} jq not installed, cannot merge permissions"
            echo -e "    Install: brew install jq"
            echo -e "    Then run: vamp setup --permissions"
            return 0
        fi

        # Get existing allow list
        local existing_perms
        existing_perms=$(jq -r '.permissions.allow // [] | .[]' "$settings_file" 2>/dev/null)

        # Check what's missing
        local missing_perms=()
        for perm in "${recommended_permissions[@]}"; do
            if ! echo "$existing_perms" | grep -qF "$perm"; then
                missing_perms+=("$perm")
            fi
        done

        if [ ${#missing_perms[@]} -eq 0 ]; then
            echo -e "  ${GREEN}✓${NC} All recommended permissions already configured"
            return 0
        fi

        # Ask to add missing permissions
        echo -e "  ${YELLOW}○${NC} Missing ${#missing_perms[@]} recommended permissions"
        echo -e "    Would add: ${missing_perms[*]:0:3}${missing_perms[3]:+...}"
        read -p "  Add missing permissions? [Y/n] " add_confirm
        if [[ ! "$add_confirm" =~ ^[Nn]$ ]]; then
            # Merge permissions using jq
            local all_perms
            all_perms=$(printf '%s\n' "${recommended_permissions[@]}")

            # Create merged JSON
            jq --argjson new_perms "$(printf '%s\n' "${recommended_permissions[@]}" | jq -R . | jq -s .)" '
                .permissions.allow = ((.permissions.allow // []) + $new_perms | unique)
            ' "$settings_file" > "${settings_file}.tmp" && mv "${settings_file}.tmp" "$settings_file"

            echo -e "  ${GREEN}✓${NC} Added missing permissions to settings.local.json"
        else
            echo -e "  ${DIM}○${NC} Skipped"
        fi
    else
        # Create new settings file
        echo -e "  ${YELLOW}○${NC} settings.local.json not found"
        read -p "  Create with recommended permissions? [Y/n] " create_confirm
        if [[ ! "$create_confirm" =~ ^[Nn]$ ]]; then
            cat > "$settings_file" << 'PERMS_EOF'
{
  "permissions": {
    "allow": [
      "Bash(bd:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)"
    ]
  }
}
PERMS_EOF
            echo -e "  ${GREEN}✓${NC} Created $settings_file with recommended permissions"
        else
            echo -e "  ${DIM}○${NC} Skipped"
        fi
    fi
}

# Install vamp dependencies (beads, bv, etc.)
install_dependencies() {
    echo -e "${CYAN}Installing vamp dependencies...${NC}"
    echo ""

    # Detect OS and package manager
    local os_name pkg_cmd
    case "$(uname -s)" in
        Darwin*) os_name="macOS"; pkg_cmd="brew install" ;;
        Linux*)
            os_name="Linux"
            command -v apt &>/dev/null && pkg_cmd="sudo apt install -y"
            command -v dnf &>/dev/null && pkg_cmd="sudo dnf install -y"
            command -v pacman &>/dev/null && pkg_cmd="sudo pacman -S"
            ;;
        *) echo -e "  ${RED}Unsupported OS${NC}"; return 1 ;;
    esac

    echo -e "${BLUE}OS:${NC} $os_name"
    echo ""

    # Helper: check if command exists
    check_cmd() {
        if command -v "$1" &>/dev/null; then
            echo -e "  ${GREEN}✓${NC} $1 installed"
            return 0
        else
            return 1
        fi
    }

    # ============================================
    # Required dependencies
    # ============================================
    echo -e "${BLUE}Required:${NC}"

    if ! check_cmd tmux; then
        echo -e "  ${YELLOW}○${NC} tmux not found"
        read -p "  Install tmux? [Y/n] " install_confirm
        if [[ ! "$install_confirm" =~ ^[Nn]$ ]]; then
            $pkg_cmd tmux && echo -e "  ${GREEN}✓${NC} tmux installed"
        fi
    fi

    # ============================================
    # Recommended tools
    # ============================================
    echo ""
    echo -e "${BLUE}Recommended tools:${NC}"

    check_cmd fzf || echo -e "  ${YELLOW}○${NC} fzf - Install: $pkg_cmd fzf"

    # ============================================
    # Beads (AI-native issue tracking)
    # ============================================
    echo ""
    echo -e "${BLUE}Beads (AI-native issue tracking):${NC}"

    if check_cmd bd; then
        local beads_version=$(bd --version 2>/dev/null | head -1)
        echo -e "    $beads_version"
    else
        echo -e "  ${YELLOW}○${NC} beads not found"

        if [[ "$os_name" == "macOS" ]]; then
            echo -e "    Recommended: brew tap steveyegge/beads && brew install beads"
            read -p "  Install beads via brew? [Y/n] " install_confirm
            if [[ ! "$install_confirm" =~ ^[Nn]$ ]]; then
                (brew tap steveyegge/beads && brew install beads) && \
                    echo -e "  ${GREEN}✓${NC} beads installed" || \
                    echo -e "  ${RED}✗${NC} Installation failed"
            fi
        else
            # Linux - try cargo
            if command -v cargo &>/dev/null; then
                echo -e "    Install via: cargo install beads"
                read -p "  Install beads via cargo? [Y/n] " install_confirm
                if [[ ! "$install_confirm" =~ ^[Nn]$ ]]; then
                    cargo install beads && \
                        echo -e "  ${GREEN}✓${NC} beads installed" || \
                        echo -e "  ${RED}✗${NC} Installation failed"
                fi
            else
                echo -e "  ${YELLOW}!${NC} cargo not found - see rustup.rs to install Rust"
                echo -e "    Then: cargo install beads"
            fi
        fi
    fi

    # ============================================
    # beads_viewer (bv) - TUI for beads
    # ============================================
    echo ""
    echo -e "${BLUE}beads_viewer (bv) - TUI for beads:${NC}"

    if check_cmd bv; then
        true
    else
        echo -e "  ${YELLOW}○${NC} beads_viewer not found"

        if command -v cargo &>/dev/null; then
            echo -e "    Install via: cargo install beads_viewer"
            read -p "  Install beads_viewer via cargo? [Y/n] " install_confirm
            if [[ ! "$install_confirm" =~ ^[Nn]$ ]]; then
                cargo install beads_viewer && \
                    echo -e "  ${GREEN}✓${NC} beads_viewer installed" || \
                    echo -e "  ${RED}✗${NC} Installation failed"
            fi
        else
            # Check if we can install rustup
            echo -e "  ${YELLOW}!${NC} cargo not found"
            echo ""
            echo -e "  ${BLUE}Rust/Cargo needed for beads_viewer${NC}"
            echo -e "    Install Rust: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
            echo -e "    Then: cargo install beads_viewer"

            read -p "  Install Rust via rustup.rs? [y/N] " rust_confirm
            if [[ "$rust_confirm" =~ ^[Yy]$ ]]; then
                curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
                # Source cargo environment
                source "$HOME/.cargo/env" 2>/dev/null || true

                if command -v cargo &>/dev/null; then
                    echo -e "  ${GREEN}✓${NC} Rust installed"
                    read -p "  Now install beads_viewer? [Y/n] " bv_confirm
                    if [[ ! "$bv_confirm" =~ ^[Nn]$ ]]; then
                        cargo install beads_viewer && \
                            echo -e "  ${GREEN}✓${NC} beads_viewer installed"
                    fi
                fi
            fi
        fi
    fi

    echo ""
    echo -e "${GREEN}Dependency check complete!${NC}"
    echo ""
    echo -e "Run ${CYAN}vamp doctor${NC} to verify setup"
}

# Validate vamp and beads setup
doctor() {
    echo -e "${CYAN}vamp doctor${NC} - Checking setup..."
    log_debug "doctor: starting diagnostics"
    echo ""

    local all_passed=true
    local warnings=()
    local fixes=()

    # Check tmux
    log_debug "Checking tmux..."
    if command -v tmux &>/dev/null; then
        local tmux_version=$(tmux -V 2>/dev/null | head -1)
        echo -e "  ${GREEN}✓${NC} tmux installed ($tmux_version)"
    else
        echo -e "  ${RED}✗${NC} tmux not installed"
        fixes+=("brew install tmux  # or apt install tmux")
        all_passed=false
    fi

    # Check Claude Code CLI
    if command -v claude &>/dev/null; then
        echo -e "  ${GREEN}✓${NC} Claude Code CLI installed"
    else
        echo -e "  ${RED}✗${NC} Claude Code CLI not installed"
        fixes+=("npm install -g @anthropic-ai/claude-code")
        all_passed=false
    fi

    # Check beads
    if command -v bd &>/dev/null; then
        local beads_version=$(bd --version 2>/dev/null | head -1)
        echo -e "  ${GREEN}✓${NC} beads installed ($beads_version)"
    else
        echo -e "  ${YELLOW}○${NC} beads not installed (optional)"
        warnings+=("brew tap steveyegge/beads && brew install beads")
    fi

    # Check beads_viewer (bv)
    if command -v bv &>/dev/null; then
        echo -e "  ${GREEN}✓${NC} beads_viewer (bv) installed"
    else
        echo -e "  ${YELLOW}○${NC} beads_viewer (bv) not installed (optional)"
        warnings+=("curl -fsSL https://raw.githubusercontent.com/Dicklesworthstone/beads_viewer/main/install.sh | bash")
    fi

    # Check Claude Code hooks
    local hooks_dir="$HOME/.claude/hooks"
    if [ -d "$hooks_dir" ] && [ -n "$(ls -A "$hooks_dir" 2>/dev/null)" ]; then
        local hook_count=$(ls -1 "$hooks_dir"/*.sh 2>/dev/null | wc -l | tr -d ' ')
        echo -e "  ${GREEN}✓${NC} Claude Code hooks installed ($hook_count hooks)"
    else
        echo -e "  ${RED}✗${NC} Claude Code hooks not installed"
        fixes+=("vamp setup  # installs beads hooks for Claude Code")
        all_passed=false
    fi

    # Check global CLAUDE.md
    local global_claude_md="$HOME/.claude/CLAUDE.md"
    if [ -f "$global_claude_md" ]; then
        if grep -q "beads\|bd " "$global_claude_md" 2>/dev/null; then
            echo -e "  ${GREEN}✓${NC} Global CLAUDE.md has beads workflow"
        else
            echo -e "  ${YELLOW}○${NC} Global CLAUDE.md exists but missing beads workflow"
            warnings+=("Add beads workflow to $global_claude_md")
        fi
    else
        echo -e "  ${YELLOW}○${NC} Global CLAUDE.md not found"
        warnings+=("Create $global_claude_md with beads workflow instructions")
    fi

    # Check recommended permissions in settings.local.json
    local settings_file="$HOME/.claude/settings.local.json"
    if [ -f "$settings_file" ]; then
        if grep -q '"Bash(bd:\*)"' "$settings_file" 2>/dev/null; then
            echo -e "  ${GREEN}✓${NC} beads permissions configured"
        else
            echo -e "  ${YELLOW}○${NC} beads permissions not in settings.local.json"
            warnings+=("Add '\"Bash(bd:*)\"' to permissions.allow in $settings_file")
        fi
    else
        echo -e "  ${YELLOW}○${NC} settings.local.json not found"
        warnings+=("Create $settings_file with recommended permissions")
    fi

    # Check beads sync branch (if in a beads project)
    if [ -d ".beads" ] || [ -f ".beads.jsonl" ]; then
        local sync_branch=$(bd config get sync.branch 2>/dev/null | grep -v "not set" || true)
        if [ -n "$sync_branch" ]; then
            echo -e "  ${GREEN}✓${NC} beads sync branch configured ($sync_branch)"
        else
            echo -e "  ${RED}✗${NC} beads sync branch not configured"
            fixes+=("bd config set sync.branch beads-sync  # CRITICAL: prevents code reversion")
            all_passed=false
        fi
    fi

    # Check vamp-sidebar
    if command -v vamp-sidebar &>/dev/null; then
        echo -e "  ${GREEN}✓${NC} vamp-sidebar installed"
    elif [ -x "$HOME/.local/bin/vamp-sidebar" ]; then
        echo -e "  ${GREEN}✓${NC} vamp-sidebar installed ($HOME/.local/bin/vamp-sidebar)"
    else
        echo -e "  ${RED}✗${NC} vamp-sidebar not installed (required for agent management UI)"
        warnings+=("cd sidebar && cargo build --release && cp target/release/vamp-sidebar ~/.local/bin/")
    fi

    # Check jq (needed for agent state management)
    if command -v jq &>/dev/null; then
        echo -e "  ${GREEN}✓${NC} jq installed"
    else
        echo -e "  ${YELLOW}○${NC} jq not installed (needed for agent management)"
        warnings+=("brew install jq")
    fi

    echo ""

    # Show fixes if any
    if [ ${#fixes[@]} -gt 0 ]; then
        echo -e "${RED}Required fixes:${NC}"
        for fix in "${fixes[@]}"; do
            echo -e "  → $fix"
        done
        echo ""
    fi

    # Show warnings if any
    if [ ${#warnings[@]} -gt 0 ]; then
        echo -e "${YELLOW}Recommendations:${NC}"
        for warning in "${warnings[@]}"; do
            echo -e "  → $warning"
        done
        echo ""
    fi

    # Summary
    if [ "$all_passed" = true ] && [ ${#warnings[@]} -eq 0 ]; then
        echo -e "${GREEN}All checks passed!${NC} ✨"
    elif [ "$all_passed" = true ]; then
        echo -e "${GREEN}Core setup OK${NC}, with ${#warnings[@]} optional recommendation(s)"
    else
        echo -e "${RED}Setup incomplete${NC} - run the fixes above"
        return 1
    fi
}

# ============================================
# Self-update
# ============================================

self_update() {
    local repo="TylerKirby/vamp"
    local api_url="https://api.github.com/repos/${repo}/releases/latest"
    local bin_dir="$HOME/.local/bin"
    local lib_dir="$HOME/.local/share/vamp"
    local check_only="${1:-}"

    command -v curl &>/dev/null || die "curl is required for update" "Install curl"

    echo -e "${BLUE}Checking for updates...${NC}"

    # Fetch latest release info
    local response
    response=$(curl -sf "$api_url") || die "Failed to fetch release info from GitHub" "Check network or visit https://github.com/${repo}/releases"

    # Extract tag name (try jq, fall back to grep)
    local latest_tag
    if command -v jq &>/dev/null; then
        latest_tag=$(echo "$response" | jq -r '.tag_name')
    else
        latest_tag=$(echo "$response" | grep '"tag_name"' | head -1 | sed 's/.*"tag_name": *"\([^"]*\)".*/\1/')
    fi

    # Strip 'v' prefix for comparison
    local latest_version="${latest_tag#v}"

    if [[ "$latest_version" == "$VAMP_VERSION" ]]; then
        echo -e "${GREEN}Already up to date (v${VAMP_VERSION})${NC}"
        return 0
    fi

    echo -e "  Current: v${VAMP_VERSION}"
    echo -e "  Latest:  v${latest_version}"

    # If --check flag, just report and exit
    if [[ "$check_only" == "--check" ]]; then
        echo -e "\n${YELLOW}Update available. Run 'vamp update' to install.${NC}"
        return 0
    fi

    # Download source tarball
    local source_url="https://github.com/${repo}/archive/refs/tags/${latest_tag}.tar.gz"

    local tmp_dir
    tmp_dir=$(mktemp -d)
    trap "rm -rf '$tmp_dir'" RETURN

    start_spinner "Downloading v${latest_version}..."
    curl -sfL "$source_url" -o "$tmp_dir/vamp.tar.gz" || {
        stop_spinner
        die "Failed to download release" "Visit https://github.com/${repo}/releases"
    }
    stop_spinner

    # Extract
    tar -xzf "$tmp_dir/vamp.tar.gz" -C "$tmp_dir" || die "Failed to extract release"
    local extracted_dir="$tmp_dir/vamp-${latest_version}"

    # Verify extracted files exist
    [[ -f "$extracted_dir/bin/vamp" ]] || die "Downloaded release missing bin/vamp"
    [[ -f "$extracted_dir/lib/vamp-utils.sh" ]] || die "Downloaded release missing lib/vamp-utils.sh"

    # Install
    mkdir -p "$bin_dir" "$lib_dir"
    cp "$extracted_dir/bin/vamp" "$bin_dir/vamp"
    chmod +x "$bin_dir/vamp"
    cp "$extracted_dir/lib/vamp-utils.sh" "$lib_dir/vamp-utils.sh"

    echo -e "${GREEN}Updated vamp: v${VAMP_VERSION} → v${latest_version}${NC}"
    echo -e "${DIM}Restart your shell to use the new version${NC}"
}

# ============================================
# Agent lifecycle management
# ============================================

AGENTS_DIR=".vamp-agents"
VAMP_DIR=".vamp"

# Agent type commands (defaults, overridable via config)
AGENT_CLAUDE_CMD="${VAMP_AGENT_CLAUDE_CMD:-$CLAUDE_CMD}"
AGENT_CLAUDE_FLAGS="${VAMP_AGENT_CLAUDE_FLAGS:-$CLAUDE_FLAGS}"
AGENT_CODEX_CMD="${VAMP_AGENT_CODEX_CMD:-codex}"
AGENT_CODEX_FLAGS="${VAMP_AGENT_CODEX_FLAGS:-}"
AGENT_CURSOR_CMD="${VAMP_AGENT_CURSOR_CMD:-cursor-agent}"
AGENT_CURSOR_FLAGS="${VAMP_AGENT_CURSOR_FLAGS:---cli}"

# Initialize .vamp directory and state file
init_vamp_dir() {
    local project_dir="${1:-$(pwd)}"

    mkdir -p "$project_dir/$VAMP_DIR"

    # Add to .gitignore if not already there
    if ! grep -q "^$VAMP_DIR/" "$project_dir/.gitignore" 2>/dev/null; then
        echo -e "\n# Vamp state\n$VAMP_DIR/\n$AGENTS_DIR/" >> "$project_dir/.gitignore"
    fi

    # Create initial state file if it doesn't exist (atomic write)
    if [ ! -f "$project_dir/$VAMP_DIR/state.json" ]; then
        local project_name=$(basename "$project_dir")
        local session_name="vamp-$(echo "$project_name" | tr '.:' '-')"
        local tmp="$project_dir/$VAMP_DIR/state.json.tmp"
        jq -nc \
            --arg name "$project_name" \
            --arg path "$project_dir" \
            --arg session "$session_name" \
            --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            '{version:"2.0.0",project:{name:$name,path:$path,session:$session},agents:[],focused_agent:"main",totals:{tokens:0,cost_usd:0},updated_at:$ts}' \
            > "$tmp" && mv "$tmp" "$project_dir/$VAMP_DIR/state.json"
    fi
}

# Generate a unique agent name
# Usage: generate_agent_name <type>
generate_agent_name() {
    local agent_type="$1"
    local project_dir="${2:-$(pwd)}"
    local state_file="$project_dir/$VAMP_DIR/state.json"
    local count=1

    if [ -f "$state_file" ] && command -v jq &>/dev/null; then
        count=$(jq --arg t "$agent_type" '[.agents[] | select(.type == $t)] | length + 1' "$state_file" 2>/dev/null || echo "1")
    fi

    # Skip names that conflict with existing worktrees or branches
    local name="${agent_type}-${count}"
    while [ -d "$project_dir/$AGENTS_DIR/$name" ] || git show-ref --verify --quiet "refs/heads/agent/$name" 2>/dev/null; do
        ((count++))
        name="${agent_type}-${count}"
    done

    echo "$name"
}

# Get agent command and flags for a given type
get_agent_cmd() {
    local agent_type="$1"
    case "$agent_type" in
        claude) echo "$AGENT_CLAUDE_CMD $AGENT_CLAUDE_FLAGS" ;;
        codex)  echo "$AGENT_CODEX_CMD $AGENT_CODEX_FLAGS" ;;
        cursor) echo "$AGENT_CURSOR_CMD $AGENT_CURSOR_FLAGS" ;;
        *)
            log_debug "get_agent_cmd: unknown type '$agent_type', falling back to claude"
            echo "$AGENT_CLAUDE_CMD $AGENT_CLAUDE_FLAGS"
            ;;
    esac
}

# Validate agent name — only allow safe characters
# Usage: validate_agent_name <name>
validate_agent_name() {
    local name="$1"
    if [ -z "$name" ]; then
        return 0  # empty is OK (will be auto-generated)
    fi
    if [[ ! "$name" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        show_error "Invalid agent name: $name" "Names may only contain letters, numbers, dots, hyphens, and underscores"
        return 1
    fi
    if [ "${#name}" -gt 64 ]; then
        show_error "Agent name too long: $name" "Names must be 64 characters or fewer"
        return 1
    fi
    return 0
}

# Create a new agent with worktree isolation
# Usage: agent_create <type> [name] [task]
agent_create() {
    local agent_type="${1:-claude}"
    local project_dir="$(pwd)"
    local agent_name="${2:-$(generate_agent_name "$agent_type" "$project_dir")}"
    local task="${3:-}"

    log_debug "agent_create: type=$agent_type name=$agent_name task=$task"

    # Validate agent type
    case "$agent_type" in
        claude|codex|cursor) ;;
        *)
            show_error "Unknown agent type: $agent_type" "Valid types: claude, codex, cursor"
            return 1
            ;;
    esac

    # Validate agent name
    validate_agent_name "$agent_name" || return 1

    # Validate git repo
    if ! git rev-parse --git-dir &>/dev/null; then
        show_error "Not a git repository" "Run 'git init' or 'vamp init' first"
        return 1
    fi

    init_vamp_dir "$project_dir"

    local branch="agent/$agent_name"
    local worktree="$project_dir/$AGENTS_DIR/$agent_name"
    local current_branch=$(git branch --show-current)
    local base_ref="${current_branch:-HEAD}"

    # Create branch if needed
    if ! git show-ref --verify --quiet "refs/heads/$branch"; then
        git branch "$branch" "$base_ref" 2>/dev/null
    fi

    # Create worktree
    mkdir -p "$project_dir/$AGENTS_DIR"
    if ! git worktree add "$worktree" "$branch" 2>/dev/null; then
        show_error "Failed to create worktree for $agent_name"
        return 1
    fi

    # Write agent context file
    cat > "$worktree/.vamp-agent" << EOF
# Vamp Agent Context
AGENT_NAME=$agent_name
AGENT_TYPE=$agent_type
AGENT_BRANCH=$branch
WORKTREE_PATH=$worktree
MAIN_PROJECT_PATH=$project_dir
TASK=$task

# IMPORTANT: All file operations must stay within WORKTREE_PATH
# NEVER edit files in MAIN_PROJECT_PATH
EOF

    echo -e "  ${GREEN}✓${NC} Created agent: $agent_name ($agent_type) → $branch"

    # Get tmux session name
    local project_name=$(basename "$project_dir")
    local session_name="vamp-$(echo "$project_name" | tr '.:' '-')"

    # Spawn agent in tmux window
    if tmux has-session -t "$session_name" 2>/dev/null; then
        agent_spawn "$agent_name" "$agent_type" "$worktree" "$session_name" "$task" "$project_dir"
    fi

    # Update state file
    state_add_agent "$project_dir" "$agent_name" "$agent_type" "$branch" "$worktree" "$task"
}

# Spawn agent process in a tmux window
agent_spawn() {
    local agent_name="$1"
    local agent_type="$2"
    local worktree="$3"
    local session_name="$4"
    local task="${5:-}"
    local project_dir="${6:-$(pwd)}"

    local agent_cmd=$(get_agent_cmd "$agent_type")

    # Create new tmux window for this agent (detached so main stays visible)
    tmux new-window -d -t "$session_name" -n "$agent_name" -c "$worktree"

    # Start the agent (escape single quotes in variables to prevent shell injection)
    local safe_worktree="${worktree//\'/\'\\\'\'}"
    local safe_task="${task//\'/\'\\\'\'}"
    local safe_name="${agent_name//\'/\'\\\'\'}"
    if [ -n "$task" ]; then
        tmux send-keys -t "$session_name:$agent_name" "cd '${safe_worktree}' && clear && echo 'Agent: ${safe_name} (${agent_type})' && ${agent_cmd} 'You are agent ${safe_name}. Read .vamp-agent for context. Your task: ${safe_task}'" Enter
    else
        tmux send-keys -t "$session_name:$agent_name" "cd '${safe_worktree}' && clear && echo 'Agent: ${safe_name} (${agent_type})' && ${agent_cmd}" Enter
    fi

    log_debug "agent_spawn: $agent_name spawned in $session_name:$agent_name"
}

# Kill an agent
agent_kill() {
    local agent_id="$1"
    local remove_worktree="${2:-}"
    local project_dir="$(pwd)"

    log_debug "agent_kill: id=$agent_id remove=$remove_worktree"

    local project_name=$(basename "$project_dir")
    local session_name="vamp-$(echo "$project_name" | tr '.:' '-')"

    # If this agent is focused, swap back to main first
    local current=$(state_get_focused_agent "$project_dir")
    if [ "$current" = "$agent_id" ]; then
        agent_focus "main"
    fi

    # Kill tmux window
    if tmux has-session -t "$session_name" 2>/dev/null; then
        tmux kill-window -t "$session_name:$agent_id" 2>/dev/null || true
    fi

    # Remove worktree if requested
    if [ "$remove_worktree" = "--remove" ]; then
        local worktree="$project_dir/$AGENTS_DIR/$agent_id"
        if [ -d "$worktree" ]; then
            git worktree remove --force "$worktree" 2>/dev/null || {
                rm -rf "$worktree"
                git worktree prune 2>/dev/null
            }
        fi
        # Delete branch
        git branch -D "agent/$agent_id" 2>/dev/null || true
        echo -e "  ${GREEN}✓${NC} Removed agent: $agent_id (worktree + branch deleted)"
    else
        echo -e "  ${GREEN}✓${NC} Killed agent: $agent_id (worktree preserved)"
    fi

    # Update state
    state_remove_agent "$project_dir" "$agent_id"
}

# Pause an agent (SIGSTOP)
agent_pause() {
    local agent_id="$1"
    local project_dir="$(pwd)"
    local state_file="$project_dir/$VAMP_DIR/state.json"

    if [ -f "$state_file" ] && command -v jq &>/dev/null; then
        local pid=$(jq -r --arg id "$agent_id" '.agents[] | select(.id == $id) | .pid' "$state_file" 2>/dev/null)
        if [ -n "$pid" ] && [ "$pid" != "0" ] && [ "$pid" != "null" ]; then
            kill -STOP "$pid" 2>/dev/null && echo -e "  ${GREEN}✓${NC} Paused agent: $agent_id"
            state_update_agent_status "$project_dir" "$agent_id" "paused"
        else
            echo -e "  ${YELLOW}○${NC} No PID found for agent: $agent_id"
        fi
    fi
}

# Resume an agent (SIGCONT)
agent_resume() {
    local agent_id="$1"
    local project_dir="$(pwd)"
    local state_file="$project_dir/$VAMP_DIR/state.json"

    if [ -f "$state_file" ] && command -v jq &>/dev/null; then
        local pid=$(jq -r --arg id "$agent_id" '.agents[] | select(.id == $id) | .pid' "$state_file" 2>/dev/null)
        if [ -n "$pid" ] && [ "$pid" != "0" ] && [ "$pid" != "null" ]; then
            kill -CONT "$pid" 2>/dev/null && echo -e "  ${GREEN}✓${NC} Resumed agent: $agent_id"
            state_update_agent_status "$project_dir" "$agent_id" "running"
        else
            echo -e "  ${YELLOW}○${NC} No PID found for agent: $agent_id"
        fi
    fi
}

# Focus on an agent by swapping its pane into the main window's left pane
agent_focus() {
    local target_id="$1"
    local project_dir="$(pwd)"
    local project_name=$(basename "$project_dir")
    local session_name="vamp-$(echo "$project_name" | tr '.:' '-')"

    tmux has-session -t "$session_name" 2>/dev/null || return 1

    local current=$(state_get_focused_agent "$project_dir")
    [ "$target_id" = "$current" ] && return 0

    # Restore current occupant back to its own window
    if [ "$current" != "main" ]; then
        tmux swap-pane -s "$session_name:main.0" -t "$session_name:${current}.0" 2>/dev/null || true
    fi
    # Bring target into the main window's left pane
    if [ "$target_id" != "main" ]; then
        tmux swap-pane -s "$session_name:${target_id}.0" -t "$session_name:main.0" 2>/dev/null || return 1
    fi

    state_set_focused_agent "$project_dir" "$target_id"
}

# Restart an agent
agent_restart() {
    local agent_id="$1"
    local project_dir="$(pwd)"
    local state_file="$project_dir/$VAMP_DIR/state.json"

    if [ -f "$state_file" ] && command -v jq &>/dev/null; then
        local agent_type=$(jq -r --arg id "$agent_id" '.agents[] | select(.id == $id) | .type' "$state_file" 2>/dev/null)
        local worktree=$(jq -r --arg id "$agent_id" '.agents[] | select(.id == $id) | .worktree' "$state_file" 2>/dev/null)
        local task=$(jq -r --arg id "$agent_id" '.agents[] | select(.id == $id) | .task' "$state_file" 2>/dev/null)
        local project_name=$(basename "$project_dir")
        local session_name="vamp-$(echo "$project_name" | tr '.:' '-')"

        # Save focus state and restore main if this agent was focused
        local was_focused=false
        local current=$(state_get_focused_agent "$project_dir")
        [ "$current" = "$agent_id" ] && was_focused=true && agent_focus "main"

        # Kill existing window
        tmux kill-window -t "$session_name:$agent_id" 2>/dev/null || true

        # Re-spawn
        if [ -n "$agent_type" ] && [ "$agent_type" != "null" ]; then
            agent_spawn "$agent_id" "$agent_type" "$worktree" "$session_name" "$task" "$project_dir"
            state_update_agent_status "$project_dir" "$agent_id" "running"
            echo -e "  ${GREEN}✓${NC} Restarted agent: $agent_id"

            # Restore focus if this agent was previously focused
            [ "$was_focused" = true ] && agent_focus "$agent_id"
        fi
    fi
}

# List all agents
agent_list() {
    local project_dir="$(pwd)"
    local state_file="$project_dir/$VAMP_DIR/state.json"

    if [ ! -f "$state_file" ]; then
        echo -e "${DIM}No agents found. Start vamp first.${NC}"
        return 0
    fi

    if ! command -v jq &>/dev/null; then
        cat "$state_file"
        return 0
    fi

    local agent_count=$(jq '.agents | length' "$state_file" 2>/dev/null)
    if [ "$agent_count" = "0" ] || [ -z "$agent_count" ]; then
        echo -e "${DIM}No agents running${NC}"
        return 0
    fi

    echo -e "${CYAN}Agents:${NC}"
    echo ""
    jq -r '.agents[] | "  \(.status | if . == "running" then "♩" elif . == "paused" then "○" else "?" end) \(.name) (\(.type)) → \(.branch) \(if .task != "" then "[\(.task)]" else "" end)"' "$state_file" 2>/dev/null
    echo ""

    local totals_tok=$(jq '.totals.tokens' "$state_file" 2>/dev/null)
    local totals_cost=$(jq '.totals.cost_usd' "$state_file" 2>/dev/null)
    echo -e "${DIM}  tok:${totals_tok:-0}  \$${totals_cost:-0.00}${NC}"
}

# Merge agent branches back to main
agent_merge() {
    local project_dir="$(pwd)"
    local merge_all="${1:-}"
    local state_file="$project_dir/$VAMP_DIR/state.json"

    if [ ! -f "$state_file" ]; then
        echo -e "${DIM}No agents found${NC}"
        return 0
    fi

    local main_branch=$(git branch --show-current)

    if command -v jq &>/dev/null; then
        local branches=$(jq -r '.agents[].branch' "$state_file" 2>/dev/null)
    else
        echo -e "${RED}jq required for agent merge${NC}"
        return 1
    fi

    if [ -z "$branches" ]; then
        echo -e "${DIM}No agent branches to merge${NC}"
        return 0
    fi

    echo -e "${CYAN}Agent branches to merge into $main_branch:${NC}"
    while read -r branch; do
        local ahead=$(git rev-list --count "$main_branch".."$branch" 2>/dev/null || echo "0")
        echo -e "  $branch ($ahead commits)"
    done <<< "$branches"
    echo ""

    if [ "$merge_all" != "--all" ]; then
        read -p "Merge these branches? [y/N] " confirm
        [[ ! "$confirm" =~ ^[Yy]$ ]] && return 1
    fi

    local merged=0
    local failed=0
    while read -r branch; do
        if git merge --no-edit "$branch" 2>/dev/null; then
            echo -e "  ${GREEN}✓${NC} Merged $branch"
            ((merged++))
        else
            echo -e "  ${RED}✗${NC} Conflict in $branch"
            git merge --abort 2>/dev/null
            ((failed++))
        fi
    done <<< "$branches"

    echo ""
    if [ "$failed" -gt 0 ]; then
        echo -e "${YELLOW}Merge complete: $merged merged, $failed conflicts${NC}"
    else
        echo -e "${GREEN}Merge complete: $merged merged${NC}"
    fi
}

# ============================================
# State file management
# ============================================

# Add an agent to the state file
state_add_agent() {
    local project_dir="$1"
    local agent_name="$2"
    local agent_type="$3"
    local branch="$4"
    local worktree="$5"
    local task="${6:-}"
    local state_file="$project_dir/$VAMP_DIR/state.json"

    if [ ! -f "$state_file" ] || ! command -v jq &>/dev/null; then
        return 0
    fi

    local now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    local project_name=$(basename "$project_dir")
    local session_name="vamp-$(echo "$project_name" | tr '.:' '-')"

    local tmp="$state_file.tmp"
    # Remove existing agent with same id first (prevent duplicates)
    jq --arg id "$agent_name" \
       --arg name "$agent_name" \
       --arg type "$agent_type" \
       --arg branch "$branch" \
       --arg worktree "$worktree" \
       --arg tmux_window "$agent_name" \
       --arg task "$task" \
       --arg now "$now" \
       '(.agents = [.agents[] | select(.id != $id)]) |
       .agents += [{
         "id": $id,
         "name": $name,
         "type": $type,
         "status": "running",
         "model": "",
         "branch": $branch,
         "worktree": $worktree,
         "tmux_window": $tmux_window,
         "task": $task,
         "pid": 0,
         "started_at": $now,
         "tokens": {"input": 0, "output": 0},
         "cost_usd": 0
       }] | .updated_at = $now' "$state_file" > "$tmp" && mv "$tmp" "$state_file"
}

# Remove an agent from the state file
state_remove_agent() {
    local project_dir="$1"
    local agent_id="$2"
    local state_file="$project_dir/$VAMP_DIR/state.json"

    if [ ! -f "$state_file" ] || ! command -v jq &>/dev/null; then
        return 0
    fi

    local now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    local tmp="$state_file.tmp"
    jq --arg id "$agent_id" --arg now "$now" \
       '.agents = [.agents[] | select(.id != $id)] | .updated_at = $now' \
       "$state_file" > "$tmp" && mv "$tmp" "$state_file"
}

# Update agent status in state file
state_update_agent_status() {
    local project_dir="$1"
    local agent_id="$2"
    local status="$3"
    local state_file="$project_dir/$VAMP_DIR/state.json"

    if [ ! -f "$state_file" ] || ! command -v jq &>/dev/null; then
        return 0
    fi

    local now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    local tmp="$state_file.tmp"
    jq --arg id "$agent_id" --arg status "$status" --arg now "$now" \
       '(.agents[] | select(.id == $id)).status = $status | .updated_at = $now' \
       "$state_file" > "$tmp" && mv "$tmp" "$state_file"
}

# Get the currently focused agent from state
state_get_focused_agent() {
    local project_dir="$1"
    local state_file="$project_dir/$VAMP_DIR/state.json"
    if [ ! -f "$state_file" ] || ! command -v jq &>/dev/null; then
        echo "main"; return 0
    fi
    local focused=$(jq -r '.focused_agent // "main"' "$state_file" 2>/dev/null)
    [ -z "$focused" ] || [ "$focused" = "null" ] && focused="main"
    echo "$focused"
}

# Set the focused agent in state
state_set_focused_agent() {
    local project_dir="$1" agent_id="$2"
    local state_file="$project_dir/$VAMP_DIR/state.json"
    if [ ! -f "$state_file" ] || ! command -v jq &>/dev/null; then return 0; fi
    local tmp="$state_file.tmp"
    jq --arg agent "$agent_id" --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
       '.focused_agent = $agent | .updated_at = $now' "$state_file" > "$tmp" && mv "$tmp" "$state_file"
}

# Refresh state from tmux (detect dead agents)
state_refresh() {
    local project_dir="${1:-$(pwd)}"
    local state_file="$project_dir/$VAMP_DIR/state.json"

    if [ ! -f "$state_file" ] || ! command -v jq &>/dev/null; then
        return 0
    fi

    local project_name=$(basename "$project_dir")
    local session_name="vamp-$(echo "$project_name" | tr '.:' '-')"

    if ! tmux has-session -t "$session_name" 2>/dev/null; then
        return 0
    fi

    local windows=$(tmux list-windows -t "$session_name" -F '#{window_name}' 2>/dev/null)
    local agent_ids=$(jq -r '.agents[].id' "$state_file" 2>/dev/null)

    while read -r agent_id; do
        [ -z "$agent_id" ] && continue
        if ! echo "$windows" | grep -q "^${agent_id}$"; then
            state_update_agent_status "$project_dir" "$agent_id" "stopped"
        fi
    done <<< "$agent_ids"

    # If the focused agent's window is gone, reset focus to main
    local current_focused=$(state_get_focused_agent "$project_dir")
    if [ "$current_focused" != "main" ]; then
        if ! echo "$windows" | grep -q "^${current_focused}$"; then
            state_set_focused_agent "$project_dir" "main"
        fi
    fi
}

# ============================================
# Sidebar restart
# ============================================

# Restart the sidebar in the current vamp session.
# Detects the session from PWD, finds the sidebar pane, kills any existing
# process there, and relaunches the sidebar binary.
restart_sidebar() {
    local project_dir="${1:-$(pwd)}"
    project_dir="$(cd "$project_dir" && pwd)"

    # Detect sidebar binary
    local sidebar_cmd=""
    if command -v vamp-sidebar &>/dev/null; then
        sidebar_cmd="vamp-sidebar"
    elif [ -x "$HOME/.local/bin/vamp-sidebar" ]; then
        sidebar_cmd="$HOME/.local/bin/vamp-sidebar"
    fi

    if [ -z "$sidebar_cmd" ]; then
        echo -e "${RED}Error:${NC} vamp-sidebar binary not found"
        echo "Build with: cd sidebar && cargo build --release && cp target/release/vamp-sidebar ~/.local/bin/"
        return 1
    fi

    # Find the vamp session for this project
    local project_name=$(basename "$project_dir")
    local session_name="vamp-$(echo "$project_name" | tr '.:' '-')"

    if ! tmux has-session -t "$session_name" 2>/dev/null; then
        echo -e "${RED}Error:${NC} No vamp session '$session_name' found"
        echo "Start one with: vamp $project_dir"
        return 1
    fi

    local state_file="$project_dir/$VAMP_DIR/state.json"

    # Kill whatever is in the sidebar pane (pane 0.1) and restart
    tmux send-keys -t "$session_name:main.1" C-c 2>/dev/null || true
    sleep 0.3
    tmux send-keys -t "$session_name:main.1" "q" 2>/dev/null || true
    sleep 0.3
    tmux send-keys -t "$session_name:main.1" "$sidebar_cmd --state-file '$state_file'" Enter

    echo -e "${GREEN}✓${NC} Sidebar restarted in session $session_name"

    # Also ensure watcher is still running
    ensure_watcher "$project_dir" "$session_name"
}

# ============================================
# Command watcher (reads sidebar commands)
# ============================================

# Update files.json with git status from all agent worktrees
update_files_data() {
    local project_dir="$1"
    local state_file="$project_dir/$VAMP_DIR/state.json"
    local files_file="$project_dir/$VAMP_DIR/files.json"

    if [ ! -f "$state_file" ] || ! command -v jq &>/dev/null; then
        return 0
    fi

    local now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    local files_json='{"files":[],"locks":{},"updated_at":"'"$now"'"}'

    # Collect file status from each agent's worktree
    local agent_ids=$(jq -r '.agents[].id' "$state_file" 2>/dev/null)
    local all_files=()

    while read -r agent_id; do
        [ -z "$agent_id" ] && continue
        local worktree=$(jq -r --arg id "$agent_id" '.agents[] | select(.id == $id) | .worktree' "$state_file" 2>/dev/null)
        [ -z "$worktree" ] || [ "$worktree" = "null" ] && continue
        [ -d "$worktree" ] || continue

        local status=$(git -C "$worktree" status --porcelain -z 2>/dev/null)
        while IFS= read -r -d '' entry; do
            [ -z "$entry" ] && continue
            local st="${entry:0:2}"
            local file="${entry:3}"
            # Normalize status
            st=$(echo "$st" | tr -d ' ')
            [ -z "$st" ] && st="?"
            all_files+=("$(printf '%s\t%s\t%s' "$file" "$agent_id" "$st")")
        done <<< "$status"
    done <<< "$agent_ids"

    # Build files JSON using jq (bash 3.2 compatible — no associative arrays)
    if [ ${#all_files[@]} -gt 0 ] && command -v jq &>/dev/null; then
        # Feed all entries to jq which handles grouping and JSON building
        local entries_input=""
        for entry in "${all_files[@]}"; do
            entries_input+="$entry"$'\n'
        done

        local entries_json
        entries_json=$(echo "$entries_input" | jq -R -s '
            split("\n") | map(select(length > 0)) |
            map(split("\t") | {path: .[0], agent: .[1], status: .[2]}) |
            group_by(.path) |
            map({
                path: .[0].path,
                agents: (map({(.agent): .status}) | add),
                conflict: (length > 1)
            })
        ' 2>/dev/null || echo "[]")

        files_json="{\"files\":$entries_json,\"locks\":{},\"updated_at\":\"$now\"}"
    fi

    # Gather worktree status for each agent
    local worktrees_json="[]"
    local agent_data
    agent_data=$(jq -r '.agents[] | [(.id // ""), (.type // ""), (.branch // ""), (.worktree // "")] | join("|")' "$state_file" 2>/dev/null)
    if [ -n "$agent_data" ]; then
        local wt_entries=""
        while IFS='|' read -r wt_id wt_type wt_branch wt_worktree; do
            [ -z "$wt_id" ] && continue
            [ "$wt_id" = "main" ] && continue
            [ -d "$wt_worktree" ] || continue

            local ahead=0
            ahead=$(git -C "$wt_worktree" rev-list --count "main..$wt_branch" 2>/dev/null || echo "0")
            local is_dirty=false
            local porcelain=$(git -C "$wt_worktree" status --porcelain 2>/dev/null)
            [ -n "$porcelain" ] && is_dirty=true

            wt_entries+=$(jq -nc --arg id "$wt_id" --arg type "$wt_type" --arg branch "$wt_branch" --argjson ahead "$ahead" --argjson dirty "$is_dirty" \
                '{agent_id: $id, agent_type: $type, branch: $branch, commits_ahead: $ahead, dirty: $dirty}')
            wt_entries+=","
        done <<< "$agent_data"

        if [ -n "$wt_entries" ]; then
            # Remove trailing comma and wrap in array
            wt_entries="${wt_entries%,}"
            worktrees_json="[$wt_entries]"
        fi
    fi

    # Merge worktrees into files_json
    if [ "$worktrees_json" != "[]" ] && command -v jq &>/dev/null; then
        files_json=$(echo "$files_json" | jq --argjson wt "$worktrees_json" '.worktrees = $wt' 2>/dev/null || echo "$files_json")
    fi

    # Collect local branches with tracking info and ahead/behind counts
    local branches_json="[]"
    local current_branch
    current_branch=$(git -C "$project_dir" branch --show-current 2>/dev/null || echo "")

    # Get agent branch names for is_agent tagging
    local agent_branches=""
    if [ -f "$state_file" ]; then
        agent_branches=$(jq -r '.agents[].branch // empty' "$state_file" 2>/dev/null)
    fi

    local branch_entries=""
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        local bname="$line"
        local is_current=false
        [ "$bname" = "$current_branch" ] && is_current=true

        # Check if this is an agent branch
        local is_agent=false
        if [ -n "$agent_branches" ] && echo "$agent_branches" | grep -qx "$bname"; then
            is_agent=true
        fi

        # Tracking info: upstream ref, ahead, behind
        local tracking=""
        local ahead=0
        local behind=0
        local upstream
        upstream=$(git -C "$project_dir" for-each-ref --format='%(upstream:short)' "refs/heads/$bname" 2>/dev/null)
        if [ -n "$upstream" ]; then
            tracking="$upstream"
            local ab
            ab=$(git -C "$project_dir" rev-list --left-right --count "$bname...$upstream" 2>/dev/null || echo "0	0")
            ahead=$(echo "$ab" | awk '{print $1}')
            behind=$(echo "$ab" | awk '{print $2}')
        else
            # No upstream — count ahead of main (or default branch)
            local default_branch
            default_branch=$(git -C "$project_dir" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||' || echo "main")
            if [ "$bname" != "$default_branch" ]; then
                ahead=$(git -C "$project_dir" rev-list --count "$default_branch..$bname" 2>/dev/null || echo "0")
                behind=$(git -C "$project_dir" rev-list --count "$bname..$default_branch" 2>/dev/null || echo "0")
            fi
        fi

        # Last commit subject (truncated to 60 chars)
        local last_commit
        last_commit=$(git -C "$project_dir" log -1 --format='%s' "$bname" 2>/dev/null | head -c 60 || echo "")

        branch_entries+=$(jq -nc --arg name "$bname" --argjson current "$is_current" --arg tracking "$tracking" \
            --argjson ahead "${ahead:-0}" --argjson behind "${behind:-0}" --arg commit "$last_commit" --argjson agent "$is_agent" \
            '{name: $name, is_current: $current, tracking: $tracking, ahead: $ahead, behind: $behind, last_commit: $commit, is_agent: $agent}')
        branch_entries+=","
    done <<< "$(git -C "$project_dir" for-each-ref --format='%(refname:short)' refs/heads/ --sort=-committerdate 2>/dev/null)"

    if [ -n "$branch_entries" ]; then
        branch_entries="${branch_entries%,}"
        branches_json="[$branch_entries]"
    fi

    # Collect remote branches
    local remotes_json="[]"
    local remote_list
    remote_list=$(git -C "$project_dir" for-each-ref --format='%(refname:short)' refs/remotes/ --sort=-committerdate 2>/dev/null | grep -v '/HEAD$')
    if [ -n "$remote_list" ]; then
        remotes_json=$(echo "$remote_list" | jq -R -s 'split("\n") | map(select(length > 0))' 2>/dev/null || echo "[]")
    fi

    # Merge branches and remotes into files_json
    if command -v jq &>/dev/null; then
        files_json=$(echo "$files_json" | jq \
            --argjson branches "$branches_json" \
            --argjson remotes "$remotes_json" \
            '.branches = $branches | .remotes = $remotes' 2>/dev/null || echo "$files_json")
    fi

    # Atomic write
    echo "$files_json" > "$files_file.tmp" && mv "$files_file.tmp" "$files_file"
}

# Update beads.json from bd list
update_beads_data() {
    local project_dir="$1"
    local beads_file="$project_dir/$VAMP_DIR/beads.json"

    if ! command -v bd &>/dev/null; then
        return 0
    fi

    if [ ! -d "$project_dir/.beads" ] && [ ! -f "$project_dir/.beads.jsonl" ]; then
        return 0
    fi

    local now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    # Get issues from beads
    local issues_json=$(cd "$project_dir" && bd list --json 2>/dev/null || echo "[]")

    if command -v jq &>/dev/null; then
        local formatted=$(echo "$issues_json" | jq '{
            issues: [.[] | {
                id: .id,
                title: .title,
                status: .status,
                priority: (.priority // 2),
                type: (.issue_type // .type // "task"),
                assignee: (.assignee // ""),
                description: (.body // .description // ""),
                created_at: (.created_at // ""),
                updated_at: (.updated_at // ""),
                dependency_count: (.dependency_count // 0),
                dependent_count: (.dependent_count // 0),
                labels: (.labels // []),
                closed_at: (.closed_at // ""),
                close_reason: (.close_reason // "")
            }],
            updated_at: "'"$now"'"
        }' 2>/dev/null)

        if [ -n "$formatted" ]; then
            echo "$formatted" > "$beads_file.tmp" && mv "$beads_file.tmp" "$beads_file"
        fi
    fi
}

# Update tree.json with project file listing and git status
update_tree_data() {
    local project_dir="$1"
    local tree_file="$project_dir/$VAMP_DIR/tree.json"

    if ! command -v jq &>/dev/null; then
        return 0
    fi

    # Must be a git repo
    if ! git -C "$project_dir" rev-parse --git-dir &>/dev/null 2>&1; then
        return 0
    fi

    local now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    # Get all tracked files
    local tracked
    tracked=$(git -C "$project_dir" ls-files 2>/dev/null)

    # Get modified/added/deleted/untracked files with status
    local status_entries
    status_entries=$(git -C "$project_dir" status --porcelain 2>/dev/null)

    # Build JSON using jq
    local tree_json
    tree_json=$(printf '%s\n' "$tracked" | jq -R -s --arg now "$now" --arg status_raw "$status_entries" '
        # Parse status entries into a lookup map
        ($status_raw | split("\n") | map(select(length > 0)) |
            map({
                key: (.[3:] | ltrimstr(" ")),
                value: (.[0:2] | gsub(" "; ""))
            }) | from_entries
        ) as $status_map |

        # Parse tracked files
        (split("\n") | map(select(length > 0))) as $files |

        # Collect unique directory paths
        ($files | map(split("/") | .[:-1]) | map(
            [range(1; length + 1)] | map(. as $n | input_filename) | null
        )) as $_ignore |

        # Build directory set from all file paths
        ([$files[] | split("/") |
            [range(1; length)] |
            map(. as $n | ($files[0] | split("/"))[:$n] | join("/"))
        ] | flatten | unique) as $dirs |

        # Build entries: dirs first, then files, sorted
        (
            [$dirs[] | {path: ., status: "", is_dir: true}] +
            [$files[] | {path: ., status: ($status_map[.] // ""), is_dir: false}]
        ) |

        # Add any untracked files from status that are not in tracked list
        . + [
            $status_map | to_entries[] |
            select(.key | IN($files[]) | not) |
            select(.key | endswith("/") | not) |
            {path: .key, status: .value, is_dir: false}
        ] |

        # Sort by path
        sort_by(.path) |
        unique_by(.path) |

        {entries: ., updated_at: $now}
    ' 2>/dev/null)

    if [ -n "$tree_json" ] && [ "$tree_json" != "null" ]; then
        echo "$tree_json" > "$tree_file.tmp" && mv "$tree_file.tmp" "$tree_file"
    fi
}

# Update metrics.json with system stats and Claude usage
update_metrics_data() {
    local project_dir="$1"
    local metrics_file="$project_dir/$VAMP_DIR/metrics.json"
    local state_file="$project_dir/$VAMP_DIR/state.json"

    if ! command -v jq &>/dev/null; then
        return 0
    fi

    local now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    # System load average
    local load1=0 load5=0 load15=0
    if [[ "$OSTYPE" == darwin* ]]; then
        local loadavg
        loadavg=$(sysctl -n vm.loadavg 2>/dev/null | tr -d '{}')
        load1=$(echo "$loadavg" | awk '{print $1}')
        load5=$(echo "$loadavg" | awk '{print $2}')
        load15=$(echo "$loadavg" | awk '{print $3}')
    elif [ -f /proc/loadavg ]; then
        read -r load1 load5 load15 _ < /proc/loadavg
    fi

    # Memory usage
    local mem_total_mb=0 mem_used_mb=0 mem_pct=0
    if [[ "$OSTYPE" == darwin* ]]; then
        local mem_total_bytes
        mem_total_bytes=$(sysctl -n hw.memsize 2>/dev/null || echo "0")
        mem_total_mb=$((mem_total_bytes / 1048576))

        # Parse vm_stat for pages used
        local page_size
        page_size=$(sysctl -n hw.pagesize 2>/dev/null || echo "4096")
        local vm_output
        vm_output=$(vm_stat 2>/dev/null)
        local pages_active pages_wired pages_speculative pages_compressed
        pages_active=$(echo "$vm_output" | awk '/Pages active:/ {gsub(/\./, "", $3); print $3}')
        pages_wired=$(echo "$vm_output" | awk '/Pages wired down:/ {gsub(/\./, "", $4); print $4}')
        pages_compressed=$(echo "$vm_output" | awk '/Pages occupied by compressor:/ {gsub(/\./, "", $5); print $5}')
        pages_active=${pages_active:-0}
        pages_wired=${pages_wired:-0}
        pages_compressed=${pages_compressed:-0}
        local used_pages=$((pages_active + pages_wired + pages_compressed))
        mem_used_mb=$((used_pages * page_size / 1048576))

        if [ "$mem_total_mb" -gt 0 ]; then
            mem_pct=$((mem_used_mb * 100 / mem_total_mb))
        fi
    elif [ -f /proc/meminfo ]; then
        local total_kb available_kb
        total_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
        available_kb=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
        mem_total_mb=$((total_kb / 1024))
        local used_kb=$((total_kb - available_kb))
        mem_used_mb=$((used_kb / 1024))
        if [ "$total_kb" -gt 0 ]; then
            mem_pct=$((used_kb * 100 / total_kb))
        fi
    fi

    # Claude stats from stats-cache.json
    local claude_json='{}'
    local stats_file="$HOME/.claude/stats-cache.json"
    if [ -f "$stats_file" ]; then
        claude_json=$(jq '{
            today_messages: (.today.messages // 0),
            today_sessions: (.today.sessions // 0),
            today_tool_calls: (.today.tool_calls // 0),
            total_messages: (.total.messages // 0),
            total_sessions: (.total.sessions // 0),
            models: [(.models // {} | to_entries[] | {
                model: .key,
                input_tokens: (.value.input_tokens // 0),
                output_tokens: (.value.output_tokens // 0),
                cache_read_tokens: (.value.cache_read_tokens // 0)
            })],
            hour_counts: (.today.hour_counts // [])
        }' "$stats_file" 2>/dev/null || echo '{}')
    fi

    # Agent processes — check liveness via tmux window existence
    local agents_json='[]'
    if [ -f "$state_file" ]; then
        local session_name
        session_name=$(jq -r '.project.session // ""' "$state_file" 2>/dev/null)
        agents_json=$(jq -r '[.agents[] | {id: .id, name: .name, status: .status, type: .type, branch: .branch, task: (.task // ""), pid: .pid}]' "$state_file" 2>/dev/null || echo '[]')

        # Check liveness: main is always alive (it's this session), others check tmux window
        local agent_count
        agent_count=$(echo "$agents_json" | jq 'length' 2>/dev/null || echo "0")
        for ((idx=0; idx<agent_count; idx++)); do
            local a_id
            a_id=$(echo "$agents_json" | jq -r ".[$idx].id" 2>/dev/null)
            local status="dead"
            if [ "$a_id" = "main" ]; then
                status="alive"
            elif [ -n "$session_name" ] && tmux list-windows -t "$session_name" -F '#{window_name}' 2>/dev/null | grep -qx "$a_id"; then
                status="alive"
            fi
            agents_json=$(echo "$agents_json" | jq --argjson idx "$idx" --arg status "$status" \
                '.[$idx].process_status = $status' 2>/dev/null || echo "$agents_json")
        done
    fi

    # Assemble final JSON
    local metrics_json
    metrics_json=$(jq -n \
        --argjson load1 "${load1:-0}" \
        --argjson load5 "${load5:-0}" \
        --argjson load15 "${load15:-0}" \
        --argjson mem_pct "${mem_pct:-0}" \
        --argjson mem_total "$mem_total_mb" \
        --argjson mem_used "$mem_used_mb" \
        --argjson claude "$claude_json" \
        --argjson agents "$agents_json" \
        --arg now "$now" \
        '{
            system: {
                load_avg: [$load1, $load5, $load15],
                memory_pct: $mem_pct,
                memory_total_mb: $mem_total,
                memory_used_mb: $mem_used
            },
            claude: $claude,
            agents: $agents,
            updated_at: $now
        }' 2>/dev/null)

    if [ -n "$metrics_json" ] && [ "$metrics_json" != "null" ]; then
        echo "$metrics_json" > "$metrics_file.tmp" && mv "$metrics_file.tmp" "$metrics_file"
    fi
}

# Write an activity log entry
log_activity() {
    local project_dir="$1"
    local agent="$2"
    local event="$3"
    local detail="${4:-}"
    local activity_file="$project_dir/$VAMP_DIR/activity.log"

    local now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    if command -v jq &>/dev/null; then
        jq -nc --arg ts "$now" --arg agent "$agent" --arg event "$event" --arg detail "$detail" \
            '{timestamp: $ts, agent: $agent, event: $event, detail: $detail}' >> "$activity_file"
    else
        # Fallback: manually escape quotes
        local safe_detail="${detail//\"/\\\"}"
        local safe_agent="${agent//\"/\\\"}"
        echo "{\"timestamp\":\"$now\",\"agent\":\"$safe_agent\",\"event\":\"$event\",\"detail\":\"$safe_detail\"}" >> "$activity_file"
    fi
}

## Ensure command watcher is running for a project directory.
## Launches watcher inside the tmux session so it lives with the session.
## Safe to call multiple times — only starts if not already alive.
ensure_watcher() {
    local project_dir="$1"
    local pid_file="$project_dir/$VAMP_DIR/watcher.pid"
    local session_name="$2"

    # Check if existing watcher is alive
    if [ -f "$pid_file" ]; then
        local old_pid
        old_pid=$(cat "$pid_file" 2>/dev/null)
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            log_debug "ensure_watcher: already running (pid=$old_pid)"
            return 0
        fi
    fi

    # Clear stale commands from dead watcher
    echo "[]" > "$project_dir/$VAMP_DIR/commands.json" 2>/dev/null

    # Get the installed vamp binary path
    local vamp_bin
    vamp_bin="$(command -v vamp 2>/dev/null || echo "$0")"

    # Launch watcher via the shell pane inside tmux.
    # nohup + disown ensures it survives if the shell pane is closed.
    # The watcher self-exits when the tmux session dies.
    if tmux has-session -t "$session_name" 2>/dev/null; then
        local watcher_cmd="nohup '$vamp_bin' _watcher '$project_dir' '$session_name' </dev/null >/dev/null 2>&1 & disown"
        tmux send-keys -t "$session_name:0.2" "$watcher_cmd" Enter
        log_debug "ensure_watcher: launched in shell pane"
        # Wait for PID file to appear with a valid, running PID
        local waited=0
        while [ $waited -lt 5 ]; do
            if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file" 2>/dev/null)" 2>/dev/null; then
                log_debug "ensure_watcher: confirmed running (pid=$(cat "$pid_file"))"
                return 0
            fi
            sleep 1
            ((waited++)) || true
        done
        log_debug "ensure_watcher: WARNING: watcher may not have started"
    fi
}

command_watcher() {
    # Disable errexit — watcher must survive transient errors
    set +e

    local project_dir="$1"
    local session_name="$2"
    local commands_file="$project_dir/$VAMP_DIR/commands.json"
    local pid_file="$project_dir/$VAMP_DIR/watcher.pid"
    local tick=0

    # Write our PID so ensure_watcher can detect us
    # BASHPID is bash 4+; on macOS bash 3.2, use sh -c 'echo $PPID' trick
    if [ -n "${BASHPID:-}" ]; then
        echo "$BASHPID" > "$pid_file"
    else
        sh -c 'echo $PPID' > "$pid_file"
    fi

    while true; do
        sleep 1
        ((tick++)) || true

        # Self-exit if tmux session is gone
        if [ -n "$session_name" ] && ! tmux has-session -t "$session_name" 2>/dev/null; then
            rm -f "$project_dir/$VAMP_DIR/watcher.pid"
            exit 0
        fi

        # Refresh agent state every cycle
        (state_refresh "$project_dir") 2>/dev/null || true

        # Update files data every 5 seconds
        # Run data updates in subshells so crashes don't kill watcher
        if (( tick % 5 == 0 )); then
            (update_files_data "$project_dir") 2>/dev/null || true
        fi

        # Update beads data every 10 seconds
        if (( tick % 10 == 0 )); then
            (update_beads_data "$project_dir") 2>/dev/null || true
        fi

        # Update tree data every 10 seconds (staggered)
        if (( tick % 10 == 5 )); then
            (update_tree_data "$project_dir") 2>/dev/null || true
        fi

        # Update metrics data every 5 seconds (staggered)
        if (( tick % 5 == 2 )); then
            (update_metrics_data "$project_dir") 2>/dev/null || true
        fi

        # Process commands
        if [ ! -f "$commands_file" ]; then
            continue
        fi

        local commands=$(cat "$commands_file" 2>/dev/null)
        if [ -z "$commands" ] || [ "$commands" = "[]" ]; then
            continue
        fi

        # Atomically clear the file (prevents losing commands written between read and clear)
        local tmp_cmd="$commands_file.tmp"
        echo "[]" > "$tmp_cmd" && mv "$tmp_cmd" "$commands_file"

        if ! command -v jq &>/dev/null; then
            continue
        fi

        # Parse all commands in a single jq call (pipe-delimited to preserve empty fields)
        local parsed
        parsed=$(echo "$commands" | jq -r '.[] | [.action, (.id // ""), (.type // ""), (.name // "")] | join("|")' 2>/dev/null)
        [ -z "$parsed" ] && continue

        while IFS='|' read -r action cmd_id cmd_type cmd_name; do
            [ -z "$action" ] && continue

            # Validate action is a known command
            case "$action" in
                create|kill|focus|pause|restart|rename|merge) ;;
                *) log_debug "command_watcher: unknown action '$action', skipping"; continue ;;
            esac

            # Validate name/id fields (reject shell metacharacters)
            if [ -n "$cmd_name" ] && [[ ! "$cmd_name" =~ ^[a-zA-Z0-9._\ -]+$ ]]; then
                log_debug "command_watcher: rejecting unsafe name '$cmd_name'"
                continue
            fi
            if [ -n "$cmd_id" ] && [[ ! "$cmd_id" =~ ^[a-zA-Z0-9._-]+$ ]]; then
                log_debug "command_watcher: rejecting unsafe id '$cmd_id'"
                continue
            fi

            log_debug "command_watcher: action=$action id=$cmd_id type=$cmd_type name=$cmd_name"

            case "$action" in
                create)
                    if [ -z "$cmd_type" ]; then
                        log_debug "command_watcher: create missing type, skipping"
                    else
                        (cd "$project_dir" && agent_create "$cmd_type" "$cmd_name") 2>/dev/null
                        log_activity "$project_dir" "${cmd_name:-$cmd_type}" "agent_create" "$cmd_type"
                    fi
                    ;;
                kill)
                    (cd "$project_dir" && agent_kill "$cmd_id" "--remove") 2>/dev/null
                    log_activity "$project_dir" "$cmd_id" "agent_kill" ""
                    ;;
                focus)
                    (cd "$project_dir" && agent_focus "$cmd_id") 2>/dev/null
                    ;;
                pause)
                    (cd "$project_dir" && agent_pause "$cmd_id") 2>/dev/null
                    log_activity "$project_dir" "$cmd_id" "agent_pause" ""
                    ;;
                restart)
                    (cd "$project_dir" && agent_restart "$cmd_id") 2>/dev/null
                    log_activity "$project_dir" "$cmd_id" "agent_restart" ""
                    ;;
                rename)
                    if [ -n "$cmd_id" ] && [ -n "$cmd_name" ]; then
                        local sf="$project_dir/$VAMP_DIR/state.json"
                        if [ -f "$sf" ]; then
                            local tmp="$sf.tmp"
                            jq --arg id "$cmd_id" --arg name "$cmd_name" \
                               '(.agents[] | select(.id == $id)).name = $name' \
                               "$sf" > "$tmp" && mv "$tmp" "$sf"
                            log_activity "$project_dir" "$cmd_id" "agent_rename" "$cmd_name"
                        fi
                    fi
                    ;;
                merge)
                    (cd "$project_dir" && agent_merge "--all") 2>/dev/null
                    log_activity "$project_dir" "system" "agent_merge" "all"
                    ;;
            esac
        done <<< "$parsed"
    done
}

# Show agent subcommand help
show_agent_help() {
    cat << EOF
${YELLOW}USAGE:${NC}
    vamp agent add <type> [name]   Add agent (claude, codex, cursor)
    vamp agent list                List all agents
    vamp agent kill <id>           Kill an agent
    vamp agent kill <id> --remove  Kill and remove worktree
    vamp agent merge [--all]       Merge agent branches to main
    vamp agent focus <id>          Switch to agent's window
    vamp agent pause <id>          Pause agent
    vamp agent resume <id>         Resume agent
    vamp agent restart <id>        Restart agent

EOF
}


# ============================================
# Main session launcher
# ============================================

start_session() {
    local PROJECT_DIR="${1:-$(pwd)}"
    PROJECT_DIR=$(cd "$PROJECT_DIR" 2>/dev/null && pwd) || {
        echo -e "${RED}Directory not found: $1${NC}"
        exit 1
    }

    local PROJECT_NAME=$(basename "$PROJECT_DIR")
    local SESSION_NAME="vamp-$(echo "$PROJECT_NAME" | tr '.:' '-')"

    echo -e "${CYAN}  ♪♫ vamp ♫♪${NC} ${DIM}v${VAMP_VERSION}${NC}"
    echo -e "${GREEN}  Project:${NC} $PROJECT_NAME"
    echo -e "${GREEN}  Path:${NC} $PROJECT_DIR"

    # Check if session exists
    if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
        echo -e "${YELLOW}Session exists. Attaching...${NC}"
        ensure_watcher "$PROJECT_DIR" "$SESSION_NAME"
        tmux attach-session -t "$SESSION_NAME"
        return 0
    fi

    # Validate tools
    if ! command -v tmux &> /dev/null; then
        echo -e "${RED}tmux not found. Install with: brew install tmux${NC}"
        exit 1
    fi

    # Initialize .vamp directory
    init_vamp_dir "$PROJECT_DIR"

    # Clear activity log from previous session and log session start
    > "$PROJECT_DIR/$VAMP_DIR/activity.log"
    log_activity "$PROJECT_DIR" "vamp" "session_start" "v${VAMP_VERSION}"

    # Reset state file — clear stale agents from previous sessions (atomic write)
    local project_name=$(basename "$PROJECT_DIR")
    local tmp_state="$PROJECT_DIR/$VAMP_DIR/state.json.tmp"
    jq -nc \
        --arg name "$project_name" \
        --arg path "$PROJECT_DIR" \
        --arg session "$SESSION_NAME" \
        --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{version:"2.0.0",project:{name:$name,path:$path,session:$session},agents:[],focused_agent:"main",totals:{tokens:0,cost_usd:0},updated_at:$ts}' \
        > "$tmp_state" && mv "$tmp_state" "$PROJECT_DIR/$VAMP_DIR/state.json"

    # Detect sidebar binary
    local SIDEBAR_CMD=""
    if command -v vamp-sidebar &>/dev/null; then
        SIDEBAR_CMD="vamp-sidebar"
    elif [ -x "$HOME/.local/bin/vamp-sidebar" ]; then
        SIDEBAR_CMD="$HOME/.local/bin/vamp-sidebar"
    fi

    # ============================================
    # Create tmux session — 3-pane layout
    # ============================================
    # Layout:
    # +---------------------------+------------------+
    # |                           |   vamp-sidebar   |
    # |      Claude Code          |   (Ratatui)      |
    # |      (main agent)         |       50%        |
    # |                           +------------------+
    # |                           |   shell          |
    # |                           |       50%        |
    # +---------------------------+------------------+
    # Left: 75%                   Right: 25%

    tmux new-session -d -s "$SESSION_NAME" -c "$PROJECT_DIR" -x "$(tput cols)" -y "$(tput lines)"
    tmux rename-window -t "$SESSION_NAME:0" "main"

    # Enable mouse support (scoped to this session only)
    tmux set-option -t "$SESSION_NAME" mouse on
    tmux set-option -t "$SESSION_NAME" focus-events on

    # Blue Note styling — match sidebar palette
    tmux set-option -t "$SESSION_NAME" status-right "vamp v${VAMP_VERSION} | %H:%M"
    tmux set-option -t "$SESSION_NAME" status-style "bg=#1c1712,fg=#c4a882"
    tmux set-option -t "$SESSION_NAME" status-left-style "fg=#d4943a,bold"
    tmux set-option -t "$SESSION_NAME" status-right-style "fg=#6b5740"
    tmux set-option -t "$SESSION_NAME" pane-border-style "fg=#4a3828"
    tmux set-option -t "$SESSION_NAME" pane-active-border-style "fg=#d4943a"
    tmux set-option -t "$SESSION_NAME" window-style "bg=#1c1712"
    tmux set-option -t "$SESSION_NAME" window-active-style "bg=#241e17"

    # Hide window tabs — users navigate via sidebar only
    tmux set-option -t "$SESSION_NAME" window-status-format ""
    tmux set-option -t "$SESSION_NAME" window-status-current-format ""

    # Split: left 75% (Claude Code) | right 25% (sidebar + shell)
    tmux split-window -t "$SESSION_NAME:0" -h -p 25 -c "$PROJECT_DIR"

    # Split right pane: top 50% (sidebar) | bottom 50% (shell)
    tmux split-window -t "$SESSION_NAME:0.1" -v -p 50 -c "$PROJECT_DIR"

    # Pane 0: Claude Code (main agent)
    local main_agent_cmd="$CLAUDE_CMD $CLAUDE_FLAGS"
    tmux send-keys -t "$SESSION_NAME:0.0" "cd '$PROJECT_DIR' && clear && $main_agent_cmd" Enter

    # Register main agent in state
    state_add_agent "$PROJECT_DIR" "main" "claude" "$(git -C "$PROJECT_DIR" branch --show-current 2>/dev/null || echo 'main')" "$PROJECT_DIR" ""

    # Pane 1: Sidebar (Ratatui) or fallback
    if [ -n "$SIDEBAR_CMD" ]; then
        tmux send-keys -t "$SESSION_NAME:0.1" "$SIDEBAR_CMD --state-file '$PROJECT_DIR/$VAMP_DIR/state.json'" Enter
    else
        # Fallback: simple agent status viewer
        tmux send-keys -t "$SESSION_NAME:0.1" "cd '$PROJECT_DIR' && echo 'Sidebar not installed. Install with: cargo build --release --manifest-path sidebar/Cargo.toml' && watch -n 2 'cat $VAMP_DIR/state.json 2>/dev/null | jq . 2>/dev/null || echo \"No state yet\"'" Enter
    fi

    # Pane 2: Shell for ad-hoc commands
    tmux send-keys -t "$SESSION_NAME:0.2" "cd '$PROJECT_DIR' && clear" Enter

    # Focus Claude pane
    tmux select-pane -t "$SESSION_NAME:0.0"

    # Start command watcher in background
    ensure_watcher "$PROJECT_DIR" "$SESSION_NAME"

    echo ""
    echo -e "${CYAN}Keybindings:${NC}"
    echo "  Ctrl-b + arrows  Navigate panes"
    echo "  Ctrl-b + z       Zoom pane"
    echo "  Ctrl-b + d       Detach"
    echo ""
    echo -e "${CYAN}Sidebar (top right):${NC}"
    echo "  Tab/Shift-Tab    Cycle tabs"
    echo "  1-6              Select tab"
    echo "  Shift-A          Add agent"
    echo "  Shift-X          Kill agent"
    echo "  f                Focus agent"
    echo ""
    echo -e "${CYAN}Shell (bottom right):${NC}"
    echo "  Ad-hoc commands, vamp agent, git, etc."
    echo ""

    tmux attach-session -t "$SESSION_NAME"
}


# ============================================
# Main entry point
# ============================================

# Only run main when executed, not sourced (allows sourcing for tests)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then

# Parse global flags (--verbose, --debug) before subcommand
args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --verbose)
            VAMP_VERBOSE=1
            shift
            ;;
        --debug)
            VAMP_DEBUG=1
            VAMP_VERBOSE=1  # debug implies verbose
            shift
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done
set -- "${args[@]}"

log_debug "vamp v${VAMP_VERSION} starting"
log_debug "Command: ${1:-<none>} Args: ${*:2}"

case "${1:-}" in
    help|--help|-h)
        show_help
        ;;
    list|ls)
        list_sessions
        ;;
    attach|a)
        attach_session "$2"
        ;;
    kill|k)
        kill_session "$2"
        ;;
    killall)
        kill_all_sessions
        ;;
    init)
        init_project
        ;;
    setup)
        shift
        setup_beads "$@"
        ;;
    doctor)
        doctor
        ;;
    agent)
        shift
        case "${1:-}" in
            add)    shift; agent_create "$@" ;;
            list)   agent_list ;;
            kill)   shift; agent_kill "$@" ;;
            merge)  shift; agent_merge "$@" ;;
            focus)  shift; agent_focus "$@" ;;
            pause)  shift; agent_pause "$@" ;;
            resume) shift; agent_resume "$@" ;;
            restart) shift; agent_restart "$@" ;;
            *)      show_agent_help ;;
        esac
        ;;
    sidebar)
        restart_sidebar "${2:-$(pwd)}"
        ;;
    update)
        shift
        self_update "$@"
        ;;
    _watcher)
        # Hidden subcommand: run command watcher (used by ensure_watcher)
        set +e
        command_watcher "$2" "$3"
        ;;
    version|--version|-v)
        echo "vamp v${VAMP_VERSION}"
        ;;
    *)
        start_session "$1"
        ;;
esac

fi  # end of sourcing guard
